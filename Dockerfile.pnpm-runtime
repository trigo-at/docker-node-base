ARG VERSION
ARG FLAVOR
FROM node:$VERSION-$FLAVOR

# Node 26.12.0 still trusts the compromised eMudhra/emSign intermediates (October 2026) through
# its bundled root store; the Node fix (nodejs/node#66871) is not in any release yet. All images
# therefore use the patched Debian CA store (bookworm 20250419~deb12u2, trixie
# 20250419+deb13u1) via --use-openssl-ca. tls-trust-check.mjs verifies
# this while building the base image and again as the first ONBUILD step of every child image,
# before any step can reach the network.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && . /etc/os-release \
    && case "$VERSION_ID" in \
         12) min=20250419~deb12u2 ;; \
         13) min=20250419+deb13u1 ;; \
         *) echo "unsupported Debian release $VERSION_ID: no known remediated ca-certificates version" >&2; exit 1 ;; \
       esac \
    && dpkg --compare-versions "$(dpkg-query --show --showformat='${Version}' ca-certificates)" ge "$min" \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_OPTIONS=--use-openssl-ca
ADD tls-trust-check.mjs /usr/local/lib/trigo/tls-trust-check.mjs
RUN node /usr/local/lib/trigo/tls-trust-check.mjs
ONBUILD RUN node /usr/local/lib/trigo/tls-trust-check.mjs

RUN npm install -g pnpm@10

ONBUILD ARG NPM_TOKEN
ADD npmrc /root/.npmrc
ADD npmrc /app/.npmrc

WORKDIR /app
ONBUILD COPY --from=builder /app .

EXPOSE 3000

# this is a workaroudn for a bug in npm > 8.6
# https://github.com/npm/cli/issues/4769
# https://github.com/npm/cli/issues/4996
USER root
RUN mkdir /.npm && chmod 777 /.npm
USER node
########################################

CMD ["pnpm", "start"]

# Build identifier base image build
ARG GIT_COMMIT
ARG BUILD_UUID
ARG BUILD_TIME

LABEL "build_uuid"="${BUILD_UUID}"
LABEL "build_time"="${BUILD_TIME}"
LABEL "git_commit"="${GIT_COMMIT}"

# Build Identifier when used as base image
ONBUILD ARG BUILD_UUID=00000
ONBUILD ARG BUILD_TIME=00000
ONBUILD ARG GIT_COMMIT=00000

ONBUILD LABEL "build_uuid"="${BUILD_UUID}"
ONBUILD LABEL "build_time"="${BUILD_TIME}"
ONBUILD LABEL "git_commit"="${GIT_COMMIT}"

ONBUILD ENV GIT_COMMIT=$GIT_COMMIT
ONBUILD ENV BUILD_UUID=$BUILD_UUID
ONBUILD ENV BUILD_TIME=$BUILD_TIME
### END TEMPLATE ###
